:80 {
  root * /app/dist
  encode gzip

  # SPA fallback: serve index.html for any path that doesn't match a real file
  try_files {path} /index.html

  file_server

  # No-cache for index.html so the browser always fetches the latest entry point
  @html {
    path /index.html
  }
  header @html Cache-Control "no-cache, no-store, must-revalidate"

  # Long-lived cache for hashed static assets produced by Vite
  @assets {
    path /assets/*
  }
  header @assets Cache-Control "public, max-age=31536000, immutable"
}
